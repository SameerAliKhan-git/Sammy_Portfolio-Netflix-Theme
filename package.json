{
  "name": "sameer-portfolio",
  "version": "2.0.0",
  "description": "Premium Netflix-themed Portfolio Website for Sameer Ali Khan",
  "main": "server.js",
  "scripts": {
    "start": "NODE_ENV=production node server.js",
    "dev": "node server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "echo \"Linting not configured\" && exit 0",
    "build:css": "cleancss -o public/styles.min.css public/styles.css",
    "build:js": "uglifyjs public/script.js -o public/script.min.js -c -m",
    "build": "npm run build:css && npm run build:js",
    "prebuild": "echo 'Building assets...'",
    "analyze": "lighthouse http://localhost:3000 --output html --output-path ./lighthouse-report.html"
  },
  "dependencies": {
    "@sentry/node": "^10.27.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "nodemailer": "^7.0.11",
    "path": "^0.12.7",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "jest": "^30.2.0",
    "lighthouse": "^11.0.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.1.4",
    "uglify-js": "^3.19.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Sameer Ali Khan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SameerAliKhan-git/portfolio"
  },
  "keywords": [
    "portfolio",
    "full-stack",
    "developer",
    "express",
    "nodejs"
  ]
}
